# Copy to .env.local and fill in. See /docs/YOUR_SETUP_CHECKLIST.md.

# Settings -> API, in your Supabase project. The anon key is safe to expose to the
# browser by design — it's what RLS exists to make safe (§5 of the spec).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Where the backend (backend/) is running.
NEXT_PUBLIC_API_URL=http://localhost:8000
