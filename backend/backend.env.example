# --- Upstream (DeepSeek), (OpenAI) — removed. Both were Aura Beta-only
# (its draft ran on OpenAI, its critic on DeepSeek's Responses API) — Aura
# Beta itself was removed on 2026-09-08 (see the top-level README's
# removal note), and neither var is read anywhere in this codebase
# anymore (confirm: `grep -rn DEEPSEEK_ OPENAI_ backend/app/` after this
# change turns up nothing but this comment). Re-add both here, plus a
# real consumer in code, if a future product needs either provider again
# — don't set these as unused placeholders in the meantime.

# --- Upstream (Z.ai / GLM), direct — no longer Kael Beta's active
# upstream as of the 2026-08-31 OpenRouter switch (see OPENROUTER_* below),
# but the provider="glm" code path (two_pass_pipeline.PassConfig.
# chat_completions_url, response_api.build_chat_completions_body) still
# works if a product's config.py ever points back at it directly.
GLM_BASE_URL="https://api.z.ai/api"
GLM_API_KEY="your-zai-api-key"

# --- Upstream (OpenRouter) — Kael Beta's draft AND critic pass, both, as
# of 2026-08-31 (deepseek-v4.1-flash for both since 2026-10-05, routed
# speed-first, no pinned provider — see app/models/kael/config.py). Base URL
# is the bare server root, same convention as the other upstream vars
# above; two_pass_pipeline.PassConfig.chat_completions_url appends the
# real path (/v1/chat/completions) itself.
OPENROUTER_BASE_URL="https://openrouter.ai/api"
OPENROUTER_API_KEY="your-openrouter-api-key"
# Optional. Speech-to-text model for the Playground microphone button (same
# OpenRouter account and key). Defaults to openai/whisper-large-v3.
# TRANSCRIPTION_MODEL="openai/whisper-large-v3"

# --- Supabase (auth, API keys, usage logging, billing) ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-public-key"

# Mixed into every API key's hash before it's stored or compared. Required:
# config.validate() refuses to start the app without it. Changing it after
# keys exist invalidates every existing key, so pick it once and keep it.
API_KEY_PEPPER="a-long-random-string"

# --- Resend (transactional auth emails: signup confirmation, password reset) ---
# RESEND_FROM_EMAIL must be an address on a domain verified in the Resend
# dashboard, or Resend's onboarding@resend.dev sandbox address (only
# delivers to the Resend account owner's own inbox — fine for testing,
# not for real signups).
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Quan AI <onboarding@resend.dev>"

# Deployed frontend origin (e.g. "https://app.quanai.dev"), no trailing
# slash and no #page fragment — used as the redirect_to on every
# Supabase admin-generated auth link (signup confirmation, password
# recovery).
FRONTEND_URL="https://your-frontend-domain.com"

# --- Email system extras (app/email_service.py, auth_email.py, rate_limit.py) —
# all optional, all have working defaults in config.py. ---
# RESEND_REPLY_TO: Reply-To header on every email (e.g. "support@quancis.space").
# Unset = replies go to the From address. Set it only once that mailbox is
# confirmed to receive mail.
# RESEND_REPLY_TO=""
# AUTH_LINK_MODE: "supabase" (default) links the confirm/reset emails to the
# Supabase-generated URL. "confirm_page" links to FRONTEND_URL/auth/confirm
# instead (one click on your own domain; stops email scanners burning the
# one-time token). Deploy the frontend's /auth/confirm route BEFORE enabling it.
# AUTH_LINK_MODE="supabase"
# AUTH_EMAIL_HOURLY_CAP: ceiling on the total signup-confirmation, password-reset
# and security-notice emails this process sends per rolling hour. Default 200;
# 0 disables the cap.
# AUTH_EMAIL_HOURLY_CAP="200"

# --- CORS — both optional, both have working defaults in config.py.
# Uncomment/set only to override the defaults (production frontend +
# localhost:3000, and *.vercel.app for preview deploys).
# ALLOWED_ORIGINS="https://platform.quancis.space,http://localhost:3000"
# VERCEL_PREVIEW_ORIGIN_REGEX="^https://[a-zA-Z0-9-]+\.vercel\.app$"

# --- Credit expiry kill switch — optional, defaults to "true" (on).
# Credits expire 12 months after they are added (app/credit_expiry.py, run once
# a day by app/scheduled_checks.py). Set to "false" to stop the daily run from
# removing any credits (a dry run through POST /api/admin/expire-credits still
# reports what would expire). Nothing expires before late 2027 in any case.
# CREDIT_EXPIRY_ENABLED="true"

# --- Upstream data policy — optional, defaults to "true" (on).
# Every upstream model call asks the router to use only providers that do not
# store prompts or train on them (provider.data_collection = "deny"; see
# app/models/kael/config.py). If no such provider is available for a model the
# request fails cleanly with a 503 instead of going to a provider that keeps
# data. Set to "false" ONLY to diagnose an outage; it changes what the Privacy
# Policy says about providers, so do not leave it off.
# UPSTREAM_REQUIRE_NO_DATA_COLLECTION="true"

# --- Daily billing check (app/scheduled_checks.py) — both optional. ---
# A loop inside the web service runs the billing reconciliation ~5 minutes
# after boot and then every 24 hours, logging one line per run.
# ADMIN_ALERT_EMAIL: where to email "drift found" / "check failed". Unset =
# log only. Set it once known drift is explained, or it re-alerts every run.
# ADMIN_ALERT_EMAIL="you@example.com"
# LOW_BALANCE_ALERTS_ENABLED: master switch for the balance emails sent to
# customers (the low-balance alert a user turns on, and the "balance has run
# out" notice). ON by default since 2026-10-13: they fire when a charge crosses
# the line (app/balance_alerts.py) and this loop is the safety net. Set to
# "false" (or 0/no/off) to turn all of them off.
# LOW_BALANCE_ALERTS_ENABLED="false"
