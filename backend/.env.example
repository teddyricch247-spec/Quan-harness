# Server
PORT=3000
# Where the frontend runs — used for CORS. Update this once you know the frontend's
# real URL (local dev origin, or wherever you end up hosting it).
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek — Responses API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub — Personal Access Token, needs the "repo" scope
GITHUB_TOKEN=

# Vercel — Account/Team token
VERCEL_TOKEN=
# Only needed if the token is on a team account rather than a personal account
VERCEL_TEAM_ID=

# Tavily
TAVILY_API_KEY=
