# Server
PORT=3000
# Where the frontend runs — used for CORS. Update this once you know the frontend's
# real URL (local dev origin, or wherever you end up hosting it).
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts every model-provider key and every other API key (GitHub, Vercel, Tavily,
# ...) you save on the Settings page — this is the ONE secret still required in the
# environment; everything else is entered through the app instead of hardcoded here.
# Generate one with: openssl rand -hex 32
# Losing/changing this makes every previously-saved key unreadable — you'd need to
# re-enter them all in Settings.
SETTINGS_ENCRYPTION_KEY=

# --- Everything below this line is OPTIONAL and only used for a one-time import ---
# The very first time the backend boots against a brand-new (empty) Settings setup,
# any of these that are filled in get copied into the encrypted `providers` /
# `secrets` tables automatically, so upgrading an existing deployment doesn't lose
# your current config. After that first boot they're never read again — add, edit, or
# rotate everything from the Settings page in the app instead. If you're starting
# fresh, skip this whole section and just use Settings.

# DeepSeek — Responses API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# A second model provider — any endpoint that speaks the OpenAI Responses API shape.
CUSTOM_LABEL=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_REASONING_EFFORTS=

# GitHub — Personal Access Token, needs the "repo" scope
GITHUB_TOKEN=

# Vercel — Account/Team token
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Tavily
TAVILY_API_KEY=
