# Copy this file to .env and fill in real values. Never commit the real .env.
# See /docs/YOUR_SETUP_CHECKLIST.md for where each of these comes from.

# --- Supabase (Settings -> API, and Settings -> API -> JWT Keys, in your project) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me

# Legacy HS256 projects: Settings -> API -> JWT Secret. Leave blank if your project
# uses the newer asymmetric (JWKS-based) signing keys instead — the backend will
# fall back to fetching SUPABASE_URL + /auth/v1/.well-known/jwks.json automatically.
SUPABASE_JWT_SECRET=

# --- GitHub OAuth App (github.com/settings/developers -> New OAuth App) ---
# Authorization callback URL should be: <BACKEND_PUBLIC_URL>/connections/github-credential/oauth-callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Fly.io Sprites (Phase 2 — the Workspace Service, §23) ---
# Create a token at https://sprites.dev/account (or `sprite org auth` with the
# CLI) — it's scoped to one org on its own, so unlike the old Fly Machines
# setup there's no separate org-slug/region var needed here. For now (you +
# your devs), a token from your personal Fly org is fine; before this goes
# live to other people, generate a new token scoped to a dedicated org
# instead. See /docs/YOUR_SETUP_CHECKLIST.md §3.
SPRITES_API_TOKEN=
SPRITES_API_BASE=https://api.sprites.dev

# --- URLs ---
# Where the frontend is deployed (used to build redirect-back URLs after OAuth).
FRONTEND_URL=http://localhost:3000
# This backend's own public URL (used to build the GitHub OAuth callback URL above).
BACKEND_PUBLIC_URL=http://localhost:8000

# Comma-separated list of origins allowed to call this API (CORS). Include your
# deployed frontend URL and http://localhost:3000 for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Live Preview (Phase 5.3 + 5.4, §23.7/§23.8) ---
# Each project's preview is served from <subdomain>.<PREVIEW_BASE_DOMAIN>. You need
# a domain you control, a wildcard DNS record (*.preview.example.com -> this
# backend) and a wildcard custom domain on your host. Leave both of these blank to
# keep Live Preview off (everything else works). See /docs/YOUR_SETUP_CHECKLIST.md.
PREVIEW_BASE_DOMAIN=
# Generate with: openssl rand -hex 32
PREVIEW_SIGNING_SECRET=
# "https" everywhere except local development.
PREVIEW_SCHEME=https
# Optional: comma-separated egress IPs/CIDRs shown to people who need to allowlist
# the harness's servers in their database firewall.
PREVIEW_EGRESS_IPS=
# Tuning (defaults are fine): billing guardrails + cold-start patience.
# PREVIEW_WS_IDLE_SECONDS=90
# PREVIEW_WS_MAX_SECONDS=900
# PREVIEW_RESPONSE_MAX_SECONDS=300
# PREVIEW_COLD_START_WAIT_SECONDS=30
