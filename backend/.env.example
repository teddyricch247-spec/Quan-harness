# Server
PORT=3000
# Where the frontend runs — used for CORS. Update this once you know the frontend's
# real URL (local dev origin, or wherever you end up hosting it).
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek — Responses API (always required; this is the harness's default provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional second provider — any endpoint that speaks the OpenAI Responses API shape
# (OpenAI itself, Azure OpenAI's Responses API, a self-hosted gateway, another vendor's
# compatible endpoint). Leave every line below blank to run DeepSeek-only — the
# provider switcher in the UI simply won't appear. Fill in CUSTOM_BASE_URL and
# CUSTOM_API_KEY to enable it.
CUSTOM_LABEL=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
# Comma-separated effort levels this model's Responses API actually accepts for
# `reasoning.effort`, e.g. "low,medium,high". Leave blank if the model takes no
# reasoning param at all (a non-reasoning model) — the harness then omits that field
# for this provider instead of guessing a value it might reject.
CUSTOM_REASONING_EFFORTS=

# GitHub — Personal Access Token, needs the "repo" scope
GITHUB_TOKEN=

# Vercel — Account/Team token
VERCEL_TOKEN=
# Only needed if the token is on a team account rather than a personal account
VERCEL_TEAM_ID=

# Tavily
TAVILY_API_KEY=
