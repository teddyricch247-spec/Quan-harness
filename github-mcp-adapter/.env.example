# Copy to .env for local testing only. Never commit the real .env —
# it's already in .gitignore. In production these are set as Render
# secrets instead (see render.yaml / the README), never in a file.

# Public-safe (this is your existing "harness" Supabase project) —
# fine to leave these as-is.
SUPABASE_URL=https://lssfnrkqwymzfhgzlhad.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Zgca3Cylka8EcxDHvC1Dsw_lWjiKnon

# Secret — put your own fine-grained PAT here for local runs only.
GITHUB_TOKEN=github_pat_replace_me

# Secret — Vercel personal access token (vercel.com/account/tokens).
# Account/team-scoped, not project-scoped — it can reach every
# project under whichever account or team it belongs to.
VERCEL_TOKEN=replace_me

# Only needed if your Vercel projects live under a Team rather than
# your personal account — Team Settings → General → Team ID. Leave
# blank for a personal account.
VERCEL_TEAM_ID=

# Secret — Supabase personal access token from
# supabase.com/dashboard/account/tokens. This is NOT the same thing
# as SUPABASE_ANON_KEY above — that key belongs to one project
# (harness) and only touches its Auth layer; this token is
# account-wide and can manage every Supabase project you have.
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Only needed for local runs — Render sets RENDER_EXTERNAL_URL for you
# automatically in production, and server.py falls back to it.
BASE_URL=http://localhost:8080
